# Public URL of this app (used for OAuth redirects)
APP_URL=http://localhost:3000

# Meta (Facebook/Instagram) app from developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0

# 32-byte key used to encrypt ad-platform tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Postgres connection string for production. Leave empty in development
# to use an embedded database stored in ./.data
DATABASE_URL=

# Shared secret ShortcutVid uses to call /api/v1/* server-to-server
SCM_API_KEY=

# Google Ads (next phase)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
