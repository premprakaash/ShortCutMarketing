# ─── App ────────────────────────────────────────────────────────────────
# Public URL of this app (used for every platform's login redirect)
APP_URL=http://localhost:3000

# 32-byte key used to encrypt ad-platform logins at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Postgres connection string for production. Leave empty in development
# to use an embedded database stored in ./.data
DATABASE_URL=

# Shared secret ShortcutVid uses to call /api/v1/* server-to-server
SCM_API_KEY=

# ─── AI ─────────────────────────────────────────────────────────────────
# Claude writes ad copy + video prompts   (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# fal.ai runs the video models: Veo, Kling, Seedance   (fal.ai/dashboard/keys)
FAL_KEY=

# ─── Ad platforms ───────────────────────────────────────────────────────
# A platform appears as "ready to connect" once its keys are set.
# Redirect URL to register on each platform:  {APP_URL}/api/connect/<platform>/callback

# Meta (Facebook & Instagram) — developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0

# Google Ads — console.cloud.google.com (OAuth client) + Google Ads API Center (developer token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25
# Optional: your manager (MCC) account ID if client accounts sit under it
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# TikTok — business-api.tiktok.com (Marketing API app)
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# LinkedIn — linkedin.com/developers (Advertising API product)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202606

# Pinterest — developers.pinterest.com
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Snapchat — business.snapchat.com → Business Details → OAuth apps
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
